# NECROPSY
# NOTE: .kiro/ is deliberately NOT ignored. It is submission evidence (E15).

.env
*.db
*.db-wal
*.db-shm

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Hypothesis keeps a local example DB; committed counterexamples live in
# tests/counterexamples.py instead.
.hypothesis/

# Runtime diagnostic written by the validator whenever a narrative falls back to
# the template. It is written relative to the current directory, so the test
# suite appends its own synthetic-repo noise to it on every run — a local
# artifact, not evidence.
fallback.log
