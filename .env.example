# NECROPSY configuration. Every value has a working default.
# The app starts, serves the demo graveyard, and passes its tests with this
# file absent and the environment completely empty.

# --- GitHub -----------------------------------------------------------------
# Optional. Raises the rate limit from 60 to 5,000 requests/hour.
# NEVER required. Never requested from a visitor. Never logged.
GITHUB_TOKEN=

# --- LLM --------------------------------------------------------------------
# LLM_PROVIDER: openai | none
#   none  -> deterministic template narratives (offline, no key, still grounded)
#   openai-> any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- Storage ----------------------------------------------------------------
DATABASE_PATH=./necropsy.db

# --- Guards -----------------------------------------------------------------
MAX_REPO_SIZE_KB=51200
MAX_REPO_FILES=5000
GITHUB_CALL_BUDGET=10
RATE_LIMIT_FLOOR=12
ANALYSIS_TIMEOUT_SECONDS=25
README_EXCERPT_CHARS=4000
MANIFEST_EXCERPT_CHARS=2000

# --- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
PORT=5000
